# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cortex_memory

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# Memory Configuration
BATCH_SIZE=30
EMBEDDING_MODEL=text-embedding-3-large
LLM_MODEL=gpt-4.1-mini

# Temporal Decay Defaults (in days)
EXPIRY_IMMUTABLE=365
EXPIRY_SEMI_MUTABLE=90
EXPIRY_MUTABLE=30
EXPIRY_EPISODIC=60
MIRACLE_WINDOW_DAYS=7
RESCUE_EXTENSION_DAYS=14

# ---------------------------------------------------------------------------
# REMind v2 (src/remind) + benchmark harness (bench/) — no databases required
# ---------------------------------------------------------------------------
# Gemini free tier (OpenAI-compatible endpoint). Free-tier content may be used by Google
# to improve its products: only send public benchmark data on the free tier.
GEMINI_API_KEY=
# Set to 1 if your Gemini key is on a paid tier (enables cost accounting)
GEMINI_PAID=
# TypeSafe Jev classifier (optional; https://console.typesafe.ai/keys)
TYPESAFE_API_KEY=
# Default provider for REMind when none is passed: openai | gemini | mock
REMIND_PROVIDER=openai
# Requests per minute cap (use ~10-15 for the Gemini free tier)
REMIND_RPM=
# Disk cache for LLM/embedding calls (re-runs are free)
REMIND_CACHE_DIR=.cache/llm

# Competitor APIs (legacy benchmark/)
MEM0_API_KEY=
ZEP_API_KEY=
